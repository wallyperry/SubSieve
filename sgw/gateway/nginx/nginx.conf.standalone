user  nginx;
worker_processes  auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    include /etc/nginx/subscribe/real_ip.conf;

    log_format  main  '$remote_addr [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_user_agent"';

    error_log   /var/log/subscribe/error.log   warn;

    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    resolver 1.1.1.1 valid=60s ipv6=off;
    resolver_timeout 5s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    include /etc/nginx/subscribe/cloud_geo.conf;
    include /etc/nginx/subscribe/whitelist.conf;
    include /etc/nginx/subscribe/ua_custom.conf;
    include /etc/nginx/subscribe/ua_whitelist.conf;

    server {
        listen 80 default_server;
        access_log off;
        return 444;
    }

    server {
        listen 443 ssl default_server;
        http2 on;

        ssl_certificate     /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        access_log  /var/log/subscribe/access.log  main;

        error_page 497 =444 @blackhole;
        location @blackhole { return 444; }

        include /etc/nginx/subscribe/blacklist.conf;
        include /etc/nginx/subscribe/admin_proxy.conf;
        include /etc/nginx/subscribe/protect.conf;

        location = /health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /favicon.ico {
            access_log off;
            return 404;
        }

        location / { return 404; }
    }
}
